# Example environment variables (never commit real tokens)

DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# Local Compose defaults only. Override outside local demos.
DATAHUB_TOKEN_SERVICE_SALT=nullspace-local-demo-salt
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=nullspace-local-demo-signing-key-change-me
DATAHUB_SECRET=nullspace-local-demo-frontend-secret-change-me
NULLSPACE_DEMAND_THRESHOLD=3
NULLSPACE_BOARD_PORT=8787
NULLSPACE_STORE=/tmp/nullspace-ghosts.json
NULLSPACE_DBT_REPO=./dbt_project
# D9 ruled YES — public fulfillment repo. Models arrive only via PR to main.
NULLSPACE_DBT_REMOTE=https://github.com/Morkeeth/nullspace-dbt
NULLSPACE_DBT_PR_BASE=main
NULLSPACE_DBT_REPO_SLUG=Morkeeth/nullspace-dbt
# Optional override; otherwise the authenticated `gh` CLI credentials are used.
# NULLSPACE_DBT_TOKEN=
# Set to 1 only for one-command demos that may merge immediately after opening.
NULLSPACE_AUTO_MERGE_PR=0
NULLSPACE_DEMO_ASSET=trial_to_paid_conversion_by_cohort
NULLSPACE_WAREHOUSE_SOURCE_URN=urn:li:dataset:(urn:li:dataPlatform:postgres,local-warehouse.warehouse.ecommerce.trials,DEV)

# Optional LLM keys for the agent runtime once a concept is locked
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
